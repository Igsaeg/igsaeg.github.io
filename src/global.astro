<style is:global>
    @font-face {
        font-family: "Inter";
        src: url("./assets/fonts/Inter.woff2") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;

        ascent-override: 80%;
        descent-override: 10%;
    }

    @font-face {
        font-family: "Stack Sans Text";
        src: url("./assets/fonts/StackSansText.woff2") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
    }

    :root {
        --font-primary: 'Inter';
        --font-secondary: 'Stack Sans Text';
    
        --bg: 255, 255, 255;
        --faint: 204, 204, 204;
        --black: 17, 17, 17;
        --off-white: 227, 227, 227;
    
        --opacity-faint: 0.6;
    
        --border-soft: 1px solid rgb(var(--faint));
        --transition: 0.2s ease;
        --transition-slow: 0.4s ease;
    }
    
    ::selection {
        background: rgb(var(--black));
        color: rgb(var(--bg));
    }
    
    ::-webkit-scrollbar { display: none; }
    
    * {
        box-sizing: border-box;
        cursor: none !important;
    }
    
    html {
        font-size: 16px;
        scroll-behavior: smooth;
    }
    
    body {
        position: relative;
        margin: 0;
        font-size: 1rem;
        background-color: rgb(var(--bg));
    }
    
    h1, h2, h3, h4, p {
        font-family: var(--font-primary);
        font-weight: 500;
        letter-spacing: -2%;
        margin: 0;
    }

    h2, h3, h4 { line-height: 1.1; }

    h1 {
        font-size: 9rem;
        line-height: 1;
    }

    h2 { font-size: 5rem; }
    
    h3 { font-size: 4rem; }
    
    p {
        font-size: 1.8rem;
        line-height: 1.2;
        color: rgb(var(--black));
    }
    
    a {
        color: inherit;
        text-decoration: none;
    }
    
    .eyebrow {
        font-family: var(--font-secondary);
        font-size: 1.3rem;
        font-weight: 400;
        color: rgba(var(--black), var(--opacity-faint));
    }
    
    .img__wrapper {
        overflow: hidden;
    }
    
    .img {
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
        user-select: none;
    }
    
    button { transition: var(--transition); }
    
    .divider { border-top: 2px solid rgb(var(--faint)); }
    
    /* ===== States ===== */
    a:hover,
    a:focus-visible,
    button:focus-visible {
        outline: none;
    }
</style>

<script>
    const hero = document.querySelector(".hero") as HTMLElement;
    const banner = document.querySelector(".hero-banner") as HTMLElement;

    function animate() {
        const rect = hero.getBoundingClientRect();

        if (rect.bottom > 0 && rect.top < window.innerHeight) {
            const baseOffset = -70;
            const parallax = -rect.top * 0.15;

            banner.style.transform = `translateY(${baseOffset + parallax}px)`;
        }

        requestAnimationFrame(animate);
    }

    animate();
</script>
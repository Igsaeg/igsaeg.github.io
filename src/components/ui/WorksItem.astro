---
const { index, title, slug, year, desc, href } = Astro.props;
---
<div class="border-t-2 border-t-(--faint)"></div>
<a href={href} class={`item item__${slug} group relative grid grid-cols-[0.5fr_1.5fr_0.75fr] items-end px-8 py-16`}>
    <p class="font-(family-name:--font-secondary) text-[1.25rem] font-medium">[{index}]</p>
    <h3 class="font-semibold leading-[0.8] [transition:var(--transition-slow)] group-hover:scale-[0.98]">{title}</h3>

    <div class="flex flex-col items-end">
        <p class="font-(family-name:--font-secondary) text-[2rem] font-normal">{year}</p>
        <p class="text-[1.5rem]">{desc}</p>
    </div>

    <span class="absolute bottom-0 left-0 h-0 w-full bg-(--off-white) mix-blend-difference [transition:height_var(--transition-slow)] group-hover:h-full"></span>
</a>
---
interface Props {
    index: string;
    title: string;
    slug: string;
    year: string;
    href: string;
    previewSrc: string;
}
const { index, title, slug, year, href, previewSrc } = Astro.props;

import arrow from '../../assets/icons/arrow-sw.svg?raw';
---
<div role="separator" aria-hidden="true" class="divider"></div>
<article class={`item item__${slug} group relative`} data-preview={previewSrc}>
    <a
        href={href}
        class="@container grid grid-cols-[16.67%_1fr_16.67%] items-end px-margin py-[4.5cqi]"
        aria-label={`${title}, ${year}`}
    >
        <span class="span-text font-secondary text-body-sm font-medium transition-450-out group-hover:text-off-white">{index}.</span>
    
        <h2 class="text-subtitle-sm font-semibold leading-[0.8] transition-450-out group-hover:scale-[0.98] group-hover:text-off-white">{title}</h2>
    
        <div class="flex justify-between items-end">
            <span class="span-text font-secondary text-body-md font-normal transition-450-out group-hover:text-off-white">{year}</span>
            <div class="size-[1.25cqi] pointer-events-none select-none text-black transition-450-out group-hover:text-off-white group-hover:rotate-90 group-hover:scale-[1.1]" set:html={arrow} />
        </div>
    </a>
    <span class="absolute bottom-0 left-0 h-0 -z-1 w-full bg-black transition-450-out group-hover:h-full"></span>
</article>
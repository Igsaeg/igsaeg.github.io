---
import { Image } from 'astro:assets';

const { src, class: className, loading: type } = Astro.props
---
<div class={`overflow-hidden ${className}`}>
    <Image
        src={src}
        alt="Banner"
        class="img block w-full h-auto pointer-events-none select-none"
        loading={type}
    />
</div>

<script>
    const img = document.querySelectorAll(".img") as NodeListOf<HTMLElement>;

    function animate() {
        const viewportHeight = window.innerHeight;

        img.forEach((img) => {
            const rect = img.getBoundingClientRect();
            const isInView = rect.top < viewportHeight && rect.bottom > 0;

            if (!isInView) {
                img.style.transform = 'translateY(0px)';
                return;
            }

            const baseOffset = -50;
            const parallax = (viewportHeight - rect.top) * 0.075;
            img.style.transform = `translateY(${baseOffset + parallax}px)`;
        });

        requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
</script>
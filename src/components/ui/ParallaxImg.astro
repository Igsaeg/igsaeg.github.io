---
import { Image } from 'astro:assets';

const { src, class: className, loading: type } = Astro.props
---
<div class={`overflow-hidden ${className} rounded-md`}>
    <div class="parallax-wrapper" style="will-change: transform;">
        <Image
            src={src}
            alt="Banner"
            class="img block w-full h-auto pointer-events-none select-none rounded-md"
            loading={type}
        />
    </div>
</div>

<script>
    const img = document.querySelectorAll(".img") as NodeListOf<HTMLElement>;

    function animate() {
        const viewportHeight = window.innerHeight;

        img.forEach((img) => {
            const rect = img.getBoundingClientRect();
            const isInView = rect.top < viewportHeight && rect.bottom > 0;

            const baseOffset = -50;
            const parallax = (viewportHeight - rect.top) * 0.075;

            const heroWrapper = img.closest('.hero-image');

            if (heroWrapper?.classList.contains('hero-entering')) {
                img.style.transform = `translateY(${baseOffset + parallax}px)`;
                return;
            }           

            if (!isInView) {
                img.style.transform = 'translateY(0px)';
                return;
            }

            img.style.transform = `translateY(${baseOffset + parallax}px)`;
        });
        
        requestAnimationFrame(animate);
    }

    animate();
</script>
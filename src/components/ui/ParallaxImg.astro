---
import { Image } from 'astro:assets';

interface Props {
    src: ImageMetadata;
    alt: string;
    loading?: "eager" | "lazy";
    class?: string;
}
const { src, alt, loading, class: className } = Astro.props;
---
<div class:list={["overflow-hidden", className]}>
    <div class="parallax-wrapper" will-change-transform>
        <Image
            src={src}
            alt={alt}
            class="img block w-full h-auto pointer-events-none select-none"
            loading={loading}
        />
    </div>
</div>

<script>
    import { lenis } from '../../scripts/lenis.js';

    const img = document.querySelectorAll(".img") as NodeListOf<HTMLElement>;

    function update() {
        const viewportHeight = window.innerHeight;
        img.forEach((img) => {
            const rect = img.getBoundingClientRect();
            if (rect.top >= viewportHeight || rect.bottom <= 0) return;
            const parallax = (viewportHeight - rect.top) * 0.08;
            img.style.transform = `translateY(${-50 + parallax}px)`;
        });
    };

    lenis.on('scroll', update) ?? window.addEventListener('scroll', update);
    update();
</script>
---
interface Props {
    title: string;
    items: string[];
    bg?: "dark" | "light";
}
const { title, items, bg = "light" } = Astro.props;
const color = bg === "dark" ? "--off-white" : "--black";
---
<div>
    <p class="eyebrow mb-2">{title}</p>
    <ul class="flex flex-col gap-1">
        {items.map((item) => <li><p class={`text-(${color})`}>{item}</p></li>)}
    </ul>
</div>
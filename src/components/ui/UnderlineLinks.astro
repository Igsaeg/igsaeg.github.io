---
interface Props {
    title: string;
    type: string;
    where: string;
    dark?: boolean;
    size?: string;
}
const { title, type, where, dark = false, size } = Astro.props;
const color = dark ? "--off-white" : "--black";

---
<a href={where} class="group relative inline-block w-fit" data-scroll={type == "scroll" ? "" : undefined}>
    <p style={`font-size: ${size}; color: var(${color});`}>{title}</p>

    <span 
        style={`background-color: var(${color});`}
        class="
            absolute left-0 -bottom-0 h-0.75 w-full
            origin-right scale-x-0
            transition-transform duration-400 ease-in-out
            group-hover:origin-left group-hover:scale-x-100
        "
    ></span>
</a>

<script>
    import { lenis } from '../../scripts/lenis.js'

    document.querySelectorAll('a[data-scroll]').forEach((a) => {
        a.addEventListener('click', (e) => {
            e.preventDefault();

            const target = a.getAttribute('href');
            if (!target) return;
            lenis.scrollTo(target, {
                duration: 1.5,
                offset: -176,
            });
        });
    });
</script>
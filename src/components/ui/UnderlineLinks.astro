---
interface Props {
    title: string;
    type: string;
    where: string;
    size?: string;
    dark?: boolean;
}
const { title, type, where, size = "text-body-lg", dark = false } = Astro.props;
const color = dark ? "off-white" : "black";

---
<a 
    href={where} 
    class="group relative inline-block w-fit" 
    data-scroll={type == "scroll" ? "" : undefined}
>
    <span class={`span-text ${size} text-${color}`}>{title}</span>

    <span class={`bg-${color} absolute left-0 bottom-0 h-1 w-full origin-right scale-x-0 transition-transform duration-400 ease-in-out group-hover:origin-left group-hover:scale-x-100`}></span>
</a>

<script>
    import { lenis } from '../../scripts/lenis.js'

    document.querySelectorAll('a[data-scroll]').forEach((a) => {
        a.addEventListener('click', (e) => {
            e.preventDefault();

            const target = a.getAttribute('href');
            if (!target) return;
            lenis.scrollTo(target, {
                duration: 1.5,
                offset: -176,
            });
        });
    });
</script>
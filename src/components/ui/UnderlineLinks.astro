---
interface Props {
    title: string;
    type: string;
    where: string;
    dark?: boolean;
    size?: string;
}
const { title, type, where, dark = false, size } = Astro.props;
const textColor = dark ? "text-off-white" : "text-black";
const underlineColor = dark ? "bg-off-white" : "bg-black";

---
<a href={where} class="group relative inline-block w-fit" data-scroll={type == "scroll" ? "" : undefined}>
    <p class={textColor} style={`font-size: ${size};`}>{title}</p>

    <span 
        class={
            `absolute left-0 bottom-0 h-1 w-full origin-right scale-x-0 transition-transform duration-400 ease-in-out group-hover:origin-left group-hover:scale-x-100 ${underlineColor}`
        }
    ></span>
</a>

<script>
    import { lenis } from '../../scripts/lenis.js'

    document.querySelectorAll('a[data-scroll]').forEach((a) => {
        a.addEventListener('click', (e) => {
            e.preventDefault();

            const target = a.getAttribute('href');
            if (!target) return;
            lenis.scrollTo(target, {
                duration: 1.5,
                offset: -176,
            });
        });
    });
</script>
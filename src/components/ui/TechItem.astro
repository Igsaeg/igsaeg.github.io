---
import { Image } from 'astro:assets';

interface Props {
    content: { text: string; icon: ImageMetadata; }[];
    class?: string;
    [key: `data-${string}`]: string | undefined;
}

const { content, class: className, ...rest } = Astro.props;
---

<div class:list={["grid grid-cols-3", className]} {...rest}>
    {content.map((item) => (
        <div class="relative flex flex-col items-center justify-center w-[calc(100%-(--spacing(2))*2)] aspect-square m-2">
            <div class="absolute top-0 left-0 w-5 h-5 border-l-2 border-t-2 border-muted"></div>
            <div class="absolute top-0 right-0 w-5 h-5 border-r-2 border-t-2 border-muted"></div>
            <div class="absolute bottom-0 left-0 w-5 h-5 border-l-2 border-b-2 border-muted"></div>
            <div class="absolute bottom-0 right-0 w-5 h-5 border-r-2 border-b-2 border-muted"></div>
            <Image class="w-10 mb-2 pointer-events-none select-none" src={item.icon} alt={item.text} loading="lazy" />
            <p class="text-body-md">{item.text}</p>
        </div>
    ))}
</div>
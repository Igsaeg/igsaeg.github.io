---
import WorksItem from "../ui/WorksItem.astro";

import rewind from "../../assets/rewind.png";
import billsCreditCard from "../../assets/bills-credit-card.png";
import typingGame from "../../assets/typing-game.png";
import clickerGame from "../../assets/clicker-game.png";
---
<section id="portfolio-section" class="pt-margin mb-[24%]" aria-labelledby="works-title">
    <div class="@container grid grid-cols-[1fr_16.67%] mx-margin mb-[12%]">
        <h2 class="works_title text-subtitle-lg mr-[20%]">EVERY PROJECT, A STEP FORWARD.</h2>
        <span class="eyebrow span-text self-end">02. SELECTED WORK</span>
    </div>

    <div>
        <WorksItem index="01" title="REWIND" slug="rewind" year="2026" href="https://igsaeg.github.io/rewind" previewSrc={rewind.src} />
        <WorksItem index="02" title="BILLS CREDIT CARD" slug="bcc" year="2023" href="https://igsaeg.github.io/bills-credit-card" previewSrc={billsCreditCard.src} />
        <WorksItem index="03" title="TYPING GAME" slug="typing-game" year="2023" href="https://igsaeg.github.io/typing-game" previewSrc={typingGame.src} />
        <WorksItem index="04" title="CLICKER GAME" slug="clicker-game" year="2023" href="https://igsaeg.github.io/clicker-game" previewSrc={clickerGame.src} />
        <div role="separator" aria-hidden="true" class="divider"></div>

        <div class="@container mx-margin pt-[4.5cqi]">
            <p class="works_desc text-body-lg col-2 ml-[16.67%]">Built through curiosity and iterations. I like to<br>keep things simple and straightforward.<br>Every project teaches me something new.</p>
        </div>
    </div>

    <img
        class="item__preview fixed left-0 top-0 w-80 pointer-events-none opacity-0 transition-opacity transition-450-out"
        aria-hidden="true"
        role="presentation"
        loading="lazy"
    />
</section>

<script>
    import { gsap, revealText } from '../../scripts/gsap.js';

    const works = document.querySelectorAll<HTMLElement>(".item");
    const preview = document.querySelector<HTMLImageElement>(".item__preview");

    if (preview && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const xTo = gsap.quickTo(preview, "x", { duration: 0.35, ease: "power3" });
        const yTo = gsap.quickTo(preview, "y", { duration: 0.35, ease: "power3" });

        document.addEventListener('mousemove', (e) => {
            xTo(e.clientX + 8);
            yTo(e.clientY);
        });

        works.forEach((work) => {
            work.addEventListener("mouseenter", () => {
                if (work.dataset.preview) preview.src = work.dataset.preview;
                gsap.to(preview, { opacity: 1, duration: 0.1 });
            });

            work.addEventListener("mouseleave", () => {
                gsap.to(preview, { opacity: 0, duration: 0.1 });
            });
        });
    };

    document.fonts.ready.then(() => {
        revealText(document.querySelector(".works_title"), { type: "chars", scroll: true, stagger: 0.02, duration: 0.8 } as any);
        revealText(document.querySelector(".works_desc"), { type: "lines", scroll: true, stagger: 0.15, duration: 0.8 } as any);
    });
</script>
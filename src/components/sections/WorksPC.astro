---
import WorksItem from "../ui/WorksItem.astro";
import rewind from "../../assets/rewind.png";
import billsCreditCard from "../../assets/bills-credit-card.png";
import typingGame from "../../assets/typing-game.png";
import clickerGame from "../../assets/clicker-game.png";
---
<section id="works" class="flex flex-col gap-40 pt-8 pb-80">
    <div class="grid grid-cols-[1fr_auto] mx-8">
        <h2 class="works-title text-[6rem]">EVERY PROJECT, A STEP FORWARD.</h2>
        <p class="eyebrow justify-self-end self-end">02. SELECTED WORK</p>
    </div>

    <div>
        <WorksItem index="01" title="REWIND" slug="rewind" year="2026" desc="Digital Gallery" href="https://igsaeg.github.io/rewind" previewSrc={rewind.src} />
        <WorksItem index="02" title="BILLS CREDIT CARD" slug="bcc" year="2023" desc="Spending Game" href="https://igsaeg.github.io/bills-credit-card" previewSrc={billsCreditCard.src} />
        <WorksItem index="03" title="TYPING GAME" slug="typing-game" year="2023" desc="Typing Practice" href="https://igsaeg.github.io/typing-game" previewSrc={typingGame.src} />
        <WorksItem index="04" title="CLICKER GAME" slug="clicker-game" year="2023" desc="Clicker Game" href="https://igsaeg.github.io/clicker-game" previewSrc={clickerGame.src} />

        <div class="border-t-2 border-t-(--faint)"></div>

        <div class="item item__last grid grid-cols-[0.5fr_1.5fr_0.75fr] items-end px-8 pt-16">
            <p class="works-desc col-2">Built through curiosity, iteration, and countless revisions. These are the projects that best represent how I think and build.</p>
        </div>
    </div>

    <img
        class="item__preview fixed left-0 top-0 w-76 pointer-events-none opacity-0 [transition:opacity_var(--transition-slow)] rounded-md"
        src={rewind.src}
        alt=""
    />
</section>

<script>
    import { revealText } from '../../scripts/gsap.js';

    const works = document.querySelectorAll<HTMLElement>(".item:not(.item__last)");
    const preview = document.querySelector(".item__preview") as HTMLImageElement;

    let x = 0, y = 0, mouseX = 0, mouseY = 0;
    let rafId: number | null = null;

    function animate() {
        x += (mouseX - x) * 0.15;
        y += (mouseY - y) * 0.15;
        preview.style.transform = `translate(${x + 8}px, ${y}px)`;
        rafId = requestAnimationFrame(animate);
    }

    works.forEach((work) => {
        work.addEventListener("mouseenter", () => {
            if (work.dataset.preview) preview.src = work.dataset.preview;
            preview.style.opacity = "1";
            if (!rafId) animate();
        });

        work.addEventListener("mouseleave", () => {
            preview.style.opacity = "0";
            if (rafId) {
                cancelAnimationFrame(rafId);
                rafId = null;
            }
        });
    });

    window.addEventListener("mousemove", (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
    });

    document.fonts.ready.then(() => {
        revealText(document.querySelector(".works-title"), { type: "chars", stagger: 0.02, duration: 0.9 } as any);
        revealText(document.querySelector(".works-desc"), { type: "lines", stagger: 0.2, duration: 0.9 } as any);
    });
</script>
---
import ParallaxImg from '../ui/ParallaxImg.astro';
import portrait from '../../assets/portrait.jpg';
---
<section id="about" class="flex flex-col mx-8 pb-96">
    <div class="@container grid grid-cols-[1fr_auto]">
        <h1 class="about-title text-[13.5cqw]">BEHIND THE SCREEN.</h1>

        <svg class="h-[40%] self-end" viewBox="-20.34 24.84 60.72 60.72" xmlns="http://www.w3.org/2000/svg" fill="currentColor" stroke="currentColor" stroke-width="0">
            <polygon transform="rotate(45, 8.333, 8.333)" points="78.575,33.787 47.444,64.918 47.444,2.124 37.887,2.124 37.887,64.918 6.757,33.787 0,40.543 42.667,83.21 85.333,40.543"/>
        </svg>
    </div>

    <div class="grid grid-cols-[0.75fr_1fr] mt-48">
        <ParallaxImg class="about-image w-92" src={portrait} alt="Portrait of Shorekeeper" loading="lazy"/>
        
        <div class="@container flex flex-col justify-between">
            <h2 class="about-subtitle text-[9.8cqw]">LEARNING NEVER STOPS, NEITHER DO I.</h2>

            <div class="flex flex-col gap-5 mr-[24%]">
                <p class="about-text eyebrow">03. ABOUT ME</p>
                <p class="about-text text-[1.6rem]">Hi! I'm Kharl, a 20 year old developer based in the Philippines. I focus on front-end development and website designing.</p>
                <p class="about-text text-[1.6rem]">I build stuff with Astro or React, style with Tailwind CSS, improve user experience using JavaScript and GSAP, and manage my code with Git and GitHub.</p>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap, CustomEase, revealText, triggerAt  } from '../../scripts/gsap.js';

    document.fonts.ready.then(() => {
        const textSplit = document.querySelectorAll(".about-text");
        const aboutImage = document.querySelector(".about-image") as HTMLElement;

        revealText(document.querySelector(".about-title"), { type: "chars", scroll: true, stagger: 0.04, duration: 0.8 } as any);
        revealText(document.querySelector(".about-subtitle"), { type: "lines", scroll: true, stagger: 0.25, duration: 1 } as any);
        textSplit.forEach(el => {
            gsap.from(el, {
                delay: 0.6,
                opacity: 0,
                duration: 1.4,
                ease: "power4.out",
                scrollTrigger: {
                    trigger: document.querySelector(".about-subtitle"),
                    start: triggerAt,
                },
            })
        });
        gsap.from(aboutImage, {
            clipPath: "inset(0 0 100% 0)",
            duration: 1,
            ease: CustomEase.create("custom", "M0,0 C0.8,0 0.4,1 1,1 "),
            scrollTrigger: {
                trigger: aboutImage,
                start: triggerAt,
            }
        });
    });
</script>
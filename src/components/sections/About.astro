---
import ParallaxImg from '../ui/ParallaxImg.astro';
import TechItem from '../ui/TechItem.astro'

import portrait from '../../assets/portrait.jpg';
import html from '../../assets/icons/html5-logo.svg?raw';
import css from '../../assets/icons/css3-logo.svg?raw';
import javascript from '../../assets/icons/javascript-logo.svg?raw';
import python from '../../assets/icons/python-logo.svg?raw';
import tailwind from '../../assets/icons/tailwind-logo.svg?raw';
import gsap from '../../assets/icons/gsap-logo.svg?raw';
import lenis from '../../assets/icons/lenis-logo.svg?raw';
import astroLogo from '../../assets/icons/astro-logo.svg?raw';
import react from '../../assets/icons/react-logo.svg?raw';
import vite from '../../assets/icons/vite-logo.svg?raw';
import git from '../../assets/icons/git-logo.svg?raw';
import github from '../../assets/icons/github-logo.svg?raw';

const astro = astroLogo;
---
<section id="about-me-section" class="@container mx-margin pb-margin">
    <div class="grid grid-cols-[1fr_auto] mb-[12%]">
        <h1 class="about_title text-title-md">BEHIND THE SCREEN.</h1>

        <svg class="text-black h-[40%] self-end justify-self-end" aria-hidden="true" aria-label="Decorative divider" viewBox="-20.34 24.84 60.72 60.72" xmlns="http://www.w3.org/2000/svg" fill="currentColor" stroke="currentColor" stroke-width="0">
            <polygon transform="rotate(45, 8.333, 8.333)" points="78.575,33.787 47.444,64.918 47.444,2.124 37.887,2.124 37.887,64.918 6.757,33.787 0,40.543 42.667,83.21 85.333,40.543"/>
        </svg>
    </div>

    <div class="flex mb-[12%]">
        <ParallaxImg class="w-[33.33%] shrink-0" src={portrait} alt="Portrait of me" loading="lazy" />

        <div class="flex flex-col justify-between flex-1">
                <h2 class="about_subtitle text-subtitle-md ml-4">LEARNING NEVER<br>STOPS, NEITHER DO I.</h2>
    
                <div class="grid grid-cols-[25%_1fr]">
                    <p class="about_eyebrow eyebrow ml-4">03. ABOUT ME</p>

                    <div class="mr-[16.67%]">
                        <p class="about_text text-body-md mb-6">Hi! I'm Kharl, a 15 year old developer and designer based in the Philippines. I specialize on front-end development and website designing.</p>
                        <p class="about_text text-body-md mb-6">I view each project as a learning opportunity. Every challenge teaches me something new, and hands-on experience helps me grow as a developer.</p>
                    </div>
                </div>
        </div>
    </div>

    <div class="flex justify-between h-120">
        <div>
            <p class="eyebrow mb-4">04. TECH STACK — HOVER TO VIEW</p>

            <ul class="group w-fit">
                <li><span class="tech span-text text-subtitle-md leading-none transition-all duration-350 ease-[ease] hover:ml-8 hover:cursor-pointer group-hover:text-muted hover:text-black" data-target="language">LANGUAGES</span></li>
                <li><span class="tech span-text text-subtitle-md leading-none transition-all duration-350 ease-[ease] hover:ml-8 hover:cursor-pointer group-hover:text-muted hover:text-black" data-target="framework">FRAMEWORKS</span></li>
                <li><span class="tech span-text text-subtitle-md leading-none transition-all duration-350 ease-[ease] hover:ml-8 hover:cursor-pointer group-hover:text-muted hover:text-black" data-target="design">DESIGN</span></li>
                <li><span class="tech span-text text-subtitle-md leading-none transition-all duration-350 ease-[ease] hover:ml-8 hover:cursor-pointer group-hover:text-muted hover:text-black" data-target="tools">TOOLS</span></li>
            </ul>
        </div>

        <div class="w-[50%] flex flex-col">
            <TechItem class="tech_item hidden" data-category="language"
                content={[
                    {text: "HTML", icon: html},
                    {text: "CSS", icon: css},
                    {text: "JavaScript", icon: javascript},
                    {text: "Python", icon: python}
                ]}
            />
            <TechItem class="tech_item hidden" data-category="framework"
                content={[
                    {text: "Astro", icon: astro},
                    {text: "React", icon: react}
                ]}
            />
            <TechItem class="tech_item hidden" data-category="design"
                content={[
                    {text: "Tailwind", icon: tailwind},
                    {text: "GSAP", icon: gsap},
                    {text: "Lenis", icon: lenis}
                ]}
            />
            <TechItem class="tech_item hidden" data-category="tools"
                content={[
                    {text: "Vite", icon: vite},
                    {text: "Git", icon: git},
                    {text: "GitHub", icon: github}
                ]}
            />
        </div>
    </div>
</section>

<script>
    import { gsap, revealText } from '../../scripts/gsap.js';

    let activeItem: HTMLElement | null = null;

    function showCategory(el: HTMLElement) {
        const children = el.querySelectorAll(":scope > div");
        gsap.killTweensOf(children);
        gsap.fromTo(children,
            { opacity: 0, scale: 1.15 },
            { opacity: 1, scale: 1, stagger: 0.09, duration: 1.2, ease: "power4.out" }
        );
    }

    function hideCategory(el: HTMLElement) {
        const children = el.querySelectorAll(":scope > div");
        gsap.killTweensOf(children);
        gsap.set(children, { opacity: 0 });
        el.classList.add("hidden");
    }

    document.querySelectorAll<HTMLElement>(".tech").forEach((trigger) => {
        const item = document.querySelector<HTMLElement>(`.tech_item[data-category="${trigger.dataset.target}"]`);

        trigger.addEventListener("mouseenter", () => {
            if (!item || item === activeItem) return;

            if (activeItem) hideCategory(activeItem);

            item.classList.remove("hidden");
            showCategory(item);
            activeItem = item;
        });
    });
    
    document.fonts.ready.then(() => {
        revealText(document.querySelector(".about_title"), { type: "chars", scroll: true, stagger: 0.04, duration: 0.7 } as any);
    });
</script>
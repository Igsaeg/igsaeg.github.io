---
import ParallaxImg from '../ui/ParallaxImg.astro';
import TechItem from '../ui/TechItem.astro'

import portrait from '../../assets/portrait.jpg';
import arrow from '../../assets/icons/arrow-sw.svg?raw';
import html from '../../assets/icons/html5-logo.svg?raw';
import css from '../../assets/icons/css3-logo.svg?raw';
import javascript from '../../assets/icons/javascript-logo.svg?raw';
import python from '../../assets/icons/python-logo.svg?raw';
import tailwind from '../../assets/icons/tailwind-logo.svg?raw';
import gsap from '../../assets/icons/gsap-logo.svg?raw';
import lenis from '../../assets/icons/lenis-logo.svg?raw';
import astroLogo from '../../assets/icons/astro-logo.svg?raw';
import react from '../../assets/icons/react-logo.svg?raw';
import vite from '../../assets/icons/vite-logo.svg?raw';
import git from '../../assets/icons/git-logo.svg?raw';
import github from '../../assets/icons/github-logo.svg?raw';

const astro = astroLogo;
---
<section id="about-me-section" class="@container mx-margin pb-margin">
    <div class="grid grid-cols-[1fr_auto] items-end mb-[12%]">
        <h1 class="about_title text-title-md">BEHIND THE SCREEN.</h1>

        <div class="size-[10cqi] pointer-events-none select-none text-black" set:html={arrow} />
    </div>

    <div class="flex mb-[12%]">
        <ParallaxImg class="about_image w-[33.33%] shrink-0" src={portrait} alt="Portrait of me" loading="lazy" />

        <div class="flex flex-col justify-between flex-1">
            <h2 class="about_subtitle text-subtitle-md ml-auto mb-[4%]">LEARNING NEVER<br>STOPS, NEITHER DO I.</h2>

            <div class="grid grid-cols-[25%_1fr]">
                <span class="about_body eyebrow span-text justify-self-end">03. ABOUT ME</span>

                <div class="ml-[16.67%]">
                    <p class="about_body text-body-md mb-6">Hi! I'm Kharl, a 15 year old developer and designer based in the Philippines. I specialize on front end development and website designing.</p>
                    <p class="about_body text-body-md">I view each project as a learning opportunity. Every challenge teaches me something new, and hands on experience helps me grow as a developer.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="flex justify-between h-120">
        <div>
            <span class="eyebrow span-text mb-4">04. TECH STACK — HOVER TO VIEW</span>

            <ul class="group w-fit">
                <li><span class="tech span-text" data-target="language">LANGUAGES</span></li>
                <li><span class="tech span-text" data-target="framework">FRAMEWORKS</span></li>
                <li><span class="tech span-text" data-target="design">DESIGN</span></li>
                <li><span class="tech span-text" data-target="tools">TOOLS</span></li>
            </ul>
        </div>

        <div class="w-[50%] flex flex-col">
            <TechItem class="tech_item hidden" data-category="language"
                content={[
                    {text: "HTML", icon: html},
                    {text: "CSS", icon: css},
                    {text: "JavaScript", icon: javascript},
                    {text: "Python", icon: python}
                ]}
            />
            <TechItem class="tech_item hidden" data-category="framework"
                content={[
                    {text: "Astro", icon: astro},
                    {text: "React", icon: react}
                ]}
            />
            <TechItem class="tech_item hidden" data-category="design"
                content={[
                    {text: "Tailwind", icon: tailwind},
                    {text: "GSAP", icon: gsap},
                    {text: "Lenis", icon: lenis}
                ]}
            />
            <TechItem class="tech_item hidden" data-category="tools"
                content={[
                    {text: "Vite", icon: vite},
                    {text: "Git", icon: git},
                    {text: "GitHub", icon: github}
                ]}
            />
        </div>
    </div>
</section>

<script>
    import { gsap, CustomEase, revealText, triggerAt  } from '../../scripts/gsap.js';

    let activeItem: HTMLElement | null = null;

    function showCategory(el: HTMLElement) {
        const children = el.querySelectorAll(":scope > div");
        gsap.killTweensOf(children);
        gsap.fromTo(children,
            { opacity: 0, scale: 1.15 },    
            { opacity: 1, scale: 1, stagger: 0.09, duration: 1.2, ease: "power4.out" }
        );
    }

    function hideCategory(el: HTMLElement) {
        const children = el.querySelectorAll(":scope > div");
        gsap.killTweensOf(children);
        gsap.set(children, { opacity: 0 });
        el.classList.add("hidden");
    }

    document.querySelectorAll<HTMLElement>(".tech").forEach((trigger) => {
        const item = document.querySelector<HTMLElement>(`.tech_item[data-category="${trigger.dataset.target}"]`);

        trigger.addEventListener("mouseenter", () => {
            if (!item || item === activeItem) return;

            if (activeItem) hideCategory(activeItem);

            item.classList.remove("hidden");
            showCategory(item);
            activeItem = item;
        });
    });
    
    document.fonts.ready.then(() => {
        const aboutImage = document.querySelector(".about_image") as HTMLElement;

        revealText(document.querySelector(".about_title"), { type: "chars", scroll: true, stagger: 0.04, duration: 0.7 } as any);
        revealText(document.querySelector(".about_subtitle"), { type: "lines", scroll: true, stagger: 0.2, duration: 0.8 } as any);
        gsap.from(aboutImage, {
            clipPath: "inset(0 0 100% 0)",
            duration: 1,
            ease: CustomEase.create("custom", "M0,0 C0.8,0 0.4,1 1,1 "),
            scrollTrigger: {
                trigger: aboutImage,
                start: triggerAt,
            }
        });
        revealText(document.querySelector(".about_eyebrow"), { type: "chars", scroll: true, customTrigger: document.querySelector(".about_subtitle"), stagger: 0.035, duration: 0.9, delay: 0.5} as any);
        document.querySelectorAll(".about_body").forEach(el => {
            revealText(el, { type: "lines", scroll: true, customTrigger: document.querySelector(".about_subtitle"), stagger: 0.12, duration: 0.7, delay: 0.55} as any);
        });
    });
</script>
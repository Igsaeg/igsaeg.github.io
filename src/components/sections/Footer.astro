---
import UnderlineLinks from "../ui/UnderlineLinks.astro"
import List from '../ui/List.astro'
---
<section class="bg-(--black) text-(--off-white) pt-12 pb-6">
    <div class="grid grid-cols-[50vw_auto] mx-8 mb-40">
        <div>
            <h3 class="text-[4.25rem] text-inherit mb-4">IGSAEG</h3>
            <p class="text-inherit">A developer exploring minimalist design through thoughtful and functional web experiences.</p>
        </div>

        <div class="grid grid-cols-2 justify-self-end gap-x-[10vw] gap-y-10">
            <div>
                <p class="eyebrow mb-2">INSPIRED BY</p>
                <div class="flex flex-col gap-1">
                    <UnderlineLinks title="OBSCURA" action="https://obscurastudio.webflow.io" bg="dark" />
                    <UnderlineLinks title="Floyd Miles" action="https://fmportfolio.framer.website" bg="dark" />
                </div>
            </div>

            <div>
                <p class="eyebrow mb-2">FIND ME</p>
                <div class="flex flex-col gap-1">
                    <UnderlineLinks title="GitHub" action="https://github.com/Igsaeg" bg="dark" />
                    <UnderlineLinks title="Mail" action="mailto:kharlfranco26@gmail.com" bg="dark" />
                </div>
            </div>

            <List title="BUILT WITH" items={["Astro"]} bg="dark" />

            <div>
                <p class="eyebrow mb-2">MY TIME</p>
                <ul class="flex flex-col gap-1">
                    <li><p class="text-(--off-white)" id="site-time"></p></li>
                </ul>
            </div>
        </div>
    </div>

    <div>
        <h1 class="text-[14.4cqw] text-inherit whitespace-nowrap tracking-[-5%] mx-5">KHARL ALFARO</h1>
        <p class="text-[1.5rem] text-(--muted) ml-8">©2026 KHARL FRANCO ALFARO</p>
    </div>
    
    <script>
        const fmt = new Intl.DateTimeFormat('en-PH', {
            hour: 'numeric',
            minute: '2-digit',
            hour12: false,
            timeZone: 'Asia/Manila'
        });

        const tick = () => {
            const el = document.getElementById('site-time');
            if (el) {
                el.textContent = fmt.format(new Date()) + ' PHT';
            }
        };

        tick();
        
        setTimeout(() => {
            tick(); setInterval(tick, 60000);
        }, (60 - new Date().getSeconds()) * 1000);
    </script>
</section>
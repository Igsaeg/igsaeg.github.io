---
import UnderlineLinks from '../ui/UnderlineLinks.astro';
import ParallaxImg from '../ui/ParallaxImg.astro';
import banner from '../../assets/banner.jpg';
---
<section id="home" class="@container pt-22">
    <h1 class="hero-title text-[14.4cqw] whitespace-nowrap tracking-[-5%] mx-5 mb-[15dvh]">KHARL ALFARO</h1>

    <div class="grid grid-cols-[60vw_1fr] items-end gap-4 mx-8 mb-8">
        <div>
            <p class="hero-eyebrow eyebrow mb-2">01. HELLO</p>
            <p class="hero-bio">A self-taught developer based in the Philippines. Exploring web design and Front-End by building thoughtful, functional digital experiences.</p>
        </div>

        <div class="flex flex-col items-end hero-links">
            <UnderlineLinks title="GitHub" type="link" where="https://github.com/Igsaeg" />
            <UnderlineLinks title="kharlfranco26@gmail.com" type="link" where="mailto:kharlfranco26@gmail.com" />
        </div>
    </div>

    <ParallaxImg class="hero-image" src={banner} alt="Hero banner" loading="eager" />
</section>

<script>
    import { gsap, revealText } from '../../scripts/gsap.js';

    document.fonts.ready.then(() => {
        const tl = gsap.timeline();

        tl.addLabel("heroIn")
        .add(revealText(document.querySelector('.hero-title'), { type: "chars", yPercent: -100, stagger: 0.05, duration: 1.1, ease: "power4.out" } as any), "heroIn+=0.2")
        .from(document.querySelector('.hero-image .parallax-wrapper'), {
            clipPath: 'inset(40% 0 0 0)',
            duration: 1.1,
            ease: "power3.out",
        }, "heroIn+=1")
        .add(revealText(document.querySelector('.hero-eyebrow'), { type: "chars", stagger: 0.04, duration: 0.9} as any), "heroIn+=1.05")
        .add(revealText(document.querySelector('.hero-bio'), { type: "lines", stagger: 0.18, duration: 0.8} as any), "heroIn+=1.1")
        .add(revealText(document.querySelector('.hero-links'), { type: "lines", stagger: 0.18, duration: 0.8} as any), "heroIn+=1.2")
    });
</script>
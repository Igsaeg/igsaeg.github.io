---
import UnderlineLink from '../ui/UnderlineLink.astro';
---
<header class="fixed top-0 z-99 flex glex-col justify-between items-center w-full px-margin pt-8 mix-blend-difference select-none">
    <p class="text-body-md text-off-white font-semibold">IGSAEG</p>

    <nav aria-label="Main navigation" class="w-[16.67%] flex justify-between justify-self-end">
        <UnderlineLink title="Home" type="scroll" where="#hero-section" dark={true} size="text-body-sm" />
        <UnderlineLink title="Works" type="scroll" where="#portfolio-section" dark={true} size="text-body-sm" />
        <UnderlineLink title="About" type="scroll" where="#about-me-section" dark={true} size="text-body-sm" />
    </nav>
</header>
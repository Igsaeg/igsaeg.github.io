<header class="fixed top-0 z-10 flex justify-between items-center w-full px-8 pt-8 mix-blend-difference select-none">
    <p class="text-body-md text-off-white font-semibold">IGSAEG</p>

    <nav aria-label="Main navigation" class="flex gap-8">

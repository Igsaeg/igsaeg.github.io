---
import rewind from "../assets/rewind.png";
import billsCreditCard from "../assets/bills-credit-card.png";
import typingGame from "../assets/typing-game.png";
import clickerGame from "../assets/clicker-game.png";
---
<section class="flex flex-col gap-24 pb-64 pt-4">
    <div class="mx-4 grid grid-cols-[auto_auto]">
        <h2>THOUGHTFUL DESIGN. CLEAN DEVELOPMENT.</h2>
        <p class="eyebrow justify-self-end self-end">01 - SELECTED WORK</p>
    </div>

    <div class="flex flex-col">
        <div class="divider"></div>
        <a href="https://igsaeg.github.io/rewind" class="item item__rewind group relative grid grid-cols-[0.5fr_1.5fr_0.75fr] items-end px-8 py-14">
            <p class="font-(family-name:--font-secondary) text-[1.25rem] font-medium">[01]</p>
            <h3 class="text-[4.75rem] font-semibold leading-[0.8] [transition:var(--transition-slow)] group-hover:scale-[0.97]">REWIND</h3>
            <div class="text-right">
                <p class="font-(family-name:--font-secondary) text-[2rem] font-normal">2026</p>
                <p class="text-[1.25rem]">Vite · React</p>
            </div>
            <span class="absolute bottom-0 left-0 h-0 w-full bg-[rgb(var(--off-white))] mix-blend-difference transition-[height] [transition:var(--transition-slow)] group-hover:h-full"></span>
        </a>
        <div class="divider"></div>
        <a href="https://igsaeg.github.io/bills-credit-card" class="item item__bcc group relative grid grid-cols-[0.5fr_1.5fr_0.75fr] items-end px-8 py-14">
            <h4 class="font-(family-name:--font-secondary) text-[1.25rem] font-medium">[02]</h4>
            <h3 class="text-[4.75rem] font-semibold leading-[0.8] [transition:var(--transition-slow)] group-hover:scale-[0.97]">BILLS CREDIT CARD</h3>
            <div class="text-right">
                <p class="font-(family-name:--font-secondary) text-[2rem] font-normal">2023</p>
                <p class="text-[1.25rem]">HTML · JavaScript</p>
            </div>
            <span class="absolute bottom-0 left-0 h-0 w-full bg-[rgb(var(--off-white))] mix-blend-difference transition-[height] [transition:var(--transition-slow)] group-hover:h-full"></span>
        </a>
        <div class="divider"></div>
        <a href="https://igsaeg.github.io/typing-game" class="item item__typing-game group relative grid grid-cols-[0.5fr_1.5fr_0.75fr] items-end px-8 py-14">
            <h4 class="font-(family-name:--font-secondary) text-[1.25rem] font-medium">[03]</h4>
            <h3 class="text-[4.75rem] font-semibold leading-[0.8] [transition:var(--transition-slow)] group-hover:scale-[0.97]">TYPING GAME</h3>
            <div class="text-right">
                <p class="font-(family-name:--font-secondary) text-[2rem] font-normal">2023</p>
                <p class="text-[1.25rem]">HTML · JavaScript</p>
            </div>
            <span class="absolute bottom-0 left-0 h-0 w-full bg-[rgb(var(--off-white))] mix-blend-difference transition-[height] [transition:var(--transition-slow)] group-hover:h-full"></span>
        </a>
        <div class="divider"></div>
        <a href="https://igsaeg.github.io/clicker-game" class="item item__clicker-game group relative grid grid-cols-[0.5fr_1.5fr_0.75fr] items-end px-8 py-14">
            <h4 class="font-(family-name:--font-secondary) text-[1.25rem] font-medium">[04]</h4>
            <h3 class="text-[4.75rem] font-semibold leading-[0.8] [transition:var(--transition-slow)] group-hover:scale-[0.97]">CLICKER GAME</h3>
            <div class="text-right">
                <p class="font-(family-name:--font-secondary) text-[2rem] font-normal">2023</p>
                <p class="text-[1.25rem]">HTML · JavaScript</p>
            </div>
            <span class="absolute bottom-0 left-0 h-0 w-full bg-[rgb(var(--off-white))] mix-blend-difference transition-[height] [transition:var(--transition-slow)] group-hover:h-full"></span>
        </a>
        <div class="divider"></div>
        <div class="item item__last grid grid-cols-[0.5fr_1.5fr_0.75fr] items-end px-8 py-14">
            <p class="col-2">Built through curiosity, iteration, and countless revisions. These are the projects that best represent how I think and build.</p>
        </div>
    </div>

    <img
        class="item__preview fixed left-0 top-0 w-72 pointer-events-none opacity-0 [transition:opacity_var(--transition-slow)]"
        src={rewind.src}
        data-rewind={rewind.src}
        data-bcc={billsCreditCard.src}
        data-typing={typingGame.src}
        data-clicker={clickerGame.src}
        alt=""
    />
</section>

<script>
    const works = document.querySelectorAll(".item:not(.item__last)");
    const preview = document.querySelector(".item__preview") as HTMLImageElement;

    const classToData = {
        "item__rewind": preview.dataset.rewind,
        "item__bcc": preview.dataset.bcc,
        "item__typing-game": preview.dataset.typing,
        "item__clicker-game": preview.dataset.clicker
    };

    works.forEach(work => {
        work.addEventListener("mouseenter", () => {
            const classList = [...work.classList];
            for (const [cls, src] of Object.entries(classToData)) {
                if (classList.includes(cls)) {
                    if (src) preview.src = src;
                    break;
                }
            }
            preview.style.opacity = "1";
        });
        work.addEventListener("mouseleave", () => {
            preview.style.opacity = "0";
        });
    });    

    window.addEventListener("mousemove", (e) => {
        preview.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    });
</script>
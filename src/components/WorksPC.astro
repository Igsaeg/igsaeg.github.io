---
import rewind from "../assets/rewind.png";
import billsCreditCard from "../assets/bills-credit-card.png";
import typingGame from "../assets/typing-game.png";
import clickerGame from "../assets/clicker-game.png";

---
<section class="works" aria-labelledby="works-title">
    <div class="intro">
        <h2>THOUGHTFUL DESIGN. CLEAN DEVELOPMENT.</h2>
        <p class="eyebrow">01 - SELECTED WORK</p>
    </div>

    <div class="item-container">
        <div class="divider"></div>
        <a href="https://igsaeg.github.io/rewind" class="item item__rewind">
            <p class="item__number">[01]</p>
            <h3 class="item__name">REWIND</h3>
            <div class="item__details">
                <p class="details__year">2026</p>
                <p class="details__stack">Vite · React</p>
            </div>
            <span class="hover-fill"></span>
        </a>
        <div class="divider"></div>
        <a href="https://igsaeg.github.io/bills-credit-card" class="item item__bcc">
            <h4 class="item__number">[02]</h4>
            <h3 class="item__name">BILLS CREDIT CARD</h3>
            <div class="item__details">
                <p class="details__year">2023</p>
                <p class="details__stack">HTML · JavaScript</p>
            </div>
            <span class="hover-fill"></span>
        </a>
        <div class="divider"></div>
        <a href="https://igsaeg.github.io/typing-game" class="item item__typing-game">
            <h4 class="item__number">[03]</h4>
            <h3 class="item__name">TYPING GAME</h3>
            <div class="item__details">
                <p class="details__year">2023</p>
                <p class="details__stack">HTML · JavaScript</p>
            </div>
            <span class="hover-fill"></span>
        </a>
        <div class="divider"></div>
        <a href="https://igsaeg.github.io/clicker-game" class="item item__clicker-game">
            <h4 class="item__number">[04]</h4>
            <h3 class="item__name">CLICKER GAME</h3>
            <div class="item__details">
                <p class="details__year">2023</p>
                <p class="details__stack">HTML · JavaScript</p>
            </div>
            <span class="hover-fill"></span>
        </a>
        <div class="divider"></div>
        <div class="item item__last">
            <p>Built through curiosity, iteration, and countless revisions. These are the projects that best represent how I think and build.</p>
        </div>
    </div>

    <img
        class="item__preview"
        src={rewind.src}
        data-rewind={rewind.src}
        data-bcc={billsCreditCard.src}
        data-typing={typingGame.src}
        data-clicker={clickerGame.src}
        alt=""
    />
</section>

<style>
    .works {
        display: flex;
        flex-direction: column;
        gap: 6rem;
        padding: 1.75rem 0 16rem;
    }

    .intro {
        display: grid;
        grid-template-columns: auto auto;
        margin: 0 2rem;
    }

    .intro p {
        justify-self: flex-end;
        align-self: flex-end;
    }

    .item-container {
        display: flex;
        flex-direction: column;
    }

    .item {
        position: relative;
        display: grid;
        grid-template-columns: 0.5fr 1.5fr 0.75fr;
        align-items: end;
        padding: 3.5rem 2rem;
    }

    .hover-fill {
        position: absolute;
        bottom: 0;
        background: rgb(var(--off-white));
        mix-blend-mode: difference;
        height: 0;
        width: 100%;
        transition: var(--transition-slow);
    }

    .item:hover .hover-fill {
        height: 100%;
    }

    .item__number {
        font-family: var(--font-secondary);
        font-size: 1.25rem;
        font-weight: 500;
    }

    .item__name {
        font-size: 4.75rem;
        font-weight: 600;
        display: inline-block;
        line-height: 0.8;
        transition: var(--transition-slow);
    }

    .item:hover .item__name:not(.item__last) { transform: scale(0.97); }
    
    .item__details {
        justify-self: end;
        text-align: right;
    }

    .details__year {
        font-family: var(--font-secondary);
        font-size: 2rem;
        font-weight: 400;
    }

    .details__stack {
        font-size: 1.1rem;
    }

    .item__last p { grid-column: 2; }

    .item__preview {
        position: fixed;
        top: 0;
        left: 0;
        width: 18rem;
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--transition-slow);
    }
</style>

<script>
    const works = document.querySelectorAll(".item:not(.item__last)");
    const preview = document.querySelector(".item__preview") as HTMLImageElement;

    const classToData = {
        "item__rewind": preview.dataset.rewind,
        "item__bcc": preview.dataset.bcc,
        "item__typing-game": preview.dataset.typing,
        "item__clicker-game": preview.dataset.clicker
    };

    works.forEach(work => {
        work.addEventListener("mouseenter", () => {
            const classList = [...work.classList];
            for (const [cls, src] of Object.entries(classToData)) {
                if (classList.includes(cls)) {
                    if (src) preview.src = src;
                    break;
                }
            }
            preview.style.opacity = "1";
        });
        work.addEventListener("mouseleave", () => {
            preview.style.opacity = "0";
        });
    });    

    window.addEventListener("mousemove", (e) => {
        preview.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    });
</script>
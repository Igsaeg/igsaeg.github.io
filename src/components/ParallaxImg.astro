---
import { Image } from 'astro:assets';
const { src } = Astro.props
---
<div class="wrapper">
    <Image src={src} alt="Banner" class="img" loading="eager" />
</div>

<style>
    .wrapper { overflow: hidden; }

    .img {
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
        user-select: none;
    }
</style>

<script>
    const banner = document.querySelector(".img") as HTMLElement;

    function animate() {
        const scrollY = window.scrollY;
        const baseOffset = -70;
        const parallax = scrollY * 0.15;

        banner.style.transform = `translateY(${baseOffset + parallax}px)`;

        requestAnimationFrame(animate);
    }

    animate();
</script>
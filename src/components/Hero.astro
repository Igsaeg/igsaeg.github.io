---
import UnderlineLinks from './UnderlineLinks.astro'
import ParallaxImg from './ParallaxImg.astro'
import banner from '../assets/banner.jpg'
---
<section class="pt-28">
    <h1 class="text-[14.6cqw] whitespace-nowrap tracking-[-5%] mx-5 mb-32">KHARL ALFARO</h1>

    <div class="grid grid-cols-[1fr_0.5fr_0.5fr] items-end gap-4 mx-8 mb-10">
        <div>
            <p class="eyebrow mb-4">01 — HELLO</p>
            <p class="text-[2rem]">A self-taught developer based in the Philippines. Exploring web design and Front-End by building thoughtful, functional digital experiences.</p>
        </div>

        <div class="flex gap-2 justify-self-center">
            <p class="eyebrow">KEEP SCROLLING</p>

            <svg class="w-4" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill="var(--muted)" stroke="var(--muted)" stroke-width="0.75" d="M20,10 L18.607,8.565 L11,16.172 L11,0 L9,0 L9,16.172 L1.414,8.586 L0,10 C3.661,13.661 6.496,16.496 10,20 L20,10" />
            </svg>     
        </div>

        <div class="flex flex-col gap-4 items-end">
            <UnderlineLinks title="GitHub" color="--black" action="https://github.com/Igsaeg" />
            <UnderlineLinks title="kharlfranco26@gmail.com" color="--black" action="mailto:kharlfranco26@gmail.com" />
        </div>
    </div>

    <ParallaxImg src={banner} loading="eager" />
</section>